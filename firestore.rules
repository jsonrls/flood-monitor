rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /floodReports/{reportId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.keys().hasOnly([
          'schemaVersion',
          'source',
          'location',
          'latitude',
          'longitude',
          'accuracyM',
          'areaLabel',
          'selectionMethod',
          'depth',
          'vehicleAccess',
          'status',
          'stillFloodedCount',
          'clearedCount',
          'createdAt',
          'expiresAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.source == 'public-web'
        && request.resource.data.location is latlng
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.accuracyM is number
        && request.resource.data.accuracyM >= 0
        && request.resource.data.accuracyM <= 10000
        && request.resource.data.areaLabel is string
        && request.resource.data.areaLabel.size() > 0
        && request.resource.data.areaLabel.size() <= 160
        && request.resource.data.selectionMethod in ['device-location', 'map-pin']
        && request.resource.data.depth in ['none', 'ankle', 'knee', 'waist', 'chest']
        && request.resource.data.vehicleAccess in ['passable', 'difficult', 'impassable']
        && request.resource.data.status in ['active', 'clear']
        && request.resource.data.status == (request.resource.data.depth == 'none' ? 'clear' : 'active')
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(24, 'h');

      allow update: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

